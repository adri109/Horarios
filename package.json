{
  "name": "horarios",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema de gestión multi-tenant para salones de belleza (API REST con Node.js, Express, Prisma y PostgreSQL)",
  "author": "Adrián Pérez Correro",
  "license": "ISC",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "nodemon src/index.ts",
    "build": "npx prisma generate && tsc",
    "postinstall": "npx prisma generate",
    "test": "jest",
    "build:frontend:prod": "node scripts/build-frontend-prod.js",
    "prelaunch:verify": "node scripts/prelaunch-verify.js",
    "prelaunch:smoke": "node scripts/prelaunch-verify.js --smoke"
  },
  "keywords": [
    "salon",
    "citas",
    "multi-tenant",
    "vue",
    "express",
    "prisma"
  ],
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.29.0",
    "globals": "^16.2.0",
    "jest": "^30.0.0",
    "nodemon": "^3.1.10",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "typescript-eslint": "^8.34.1"
  },
  "dependencies": {
    "@prisma/client": "^6.10.0",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.3",
    "@types/nodemailer": "^6.4.21",
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "dotenv": "^16.5.0",
    "express": "^4.21.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^7.0.11",
    "pino": "^10.3.1",
    "prisma": "^6.10.0",
    "slugify": "^1.6.6",
    "socket.io": "^4.8.1",
    "typescript": "^5.8.3",
    "zod": "^4.3.6"
  }
