# Base de datos (Supabase + Prisma)
# DATABASE_URL: conexión con pooler (runtime)
# DIRECT_URL: conexión directa (migraciones)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# JWT Secret (generar uno aleatorio)
JWT_SECRET=cambia_esto_por_una_clave_segura_de_minimo_32_caracteres_aleatorios

# Server
PORT=3000
NODE_ENV=production

# Frontend URL (actualizar después de desplegar en Vercel)
FRONTEND_URL=https://tu-frontend.vercel.app

# CORS (lista explícita separada por comas)
# Ejemplo: https://tu-frontend.vercel.app,https://preview-tu-frontend.vercel.app
# Recomendación: sin slash final (/)
CORS_ORIGINS=https://tu-frontend.vercel.app

# Logging y límites HTTP
LOG_LEVEL=info
REQUEST_BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=30

# Email (SMTP). Zoho: SMTP_HOST=smtppro.zoho.eu, SMTP_USER=no-reply@tudominio.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-email@gmail.com
SMTP_PASS=tu-contraseña-de-aplicacion
# Nombre que verá el destinatario junto al correo (ej. TimeIt)
SMTP_FROM_NAME=TimeIt

# WhatsApp (opcional - Meta Business)
WHATSAPP_TOKEN=tu-token-de-whatsapp
WHATSAPP_PHONE_ID=tu-phone-id
