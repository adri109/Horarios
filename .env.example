# Database (Railway lo proporciona automáticamente)
DATABASE_URL=postgresql://user:password@host:5432/database

# JWT Secret (generar uno aleatorio)
JWT_SECRET=cambia_esto_por_una_clave_segura_de_minimo_32_caracteres_aleatorios

# Server
PORT=3000
NODE_ENV=production

# Frontend URL (actualizar después de desplegar en Vercel)
FRONTEND_URL=https://tu-frontend.vercel.app

# Email (opcional - Gmail)
SMTP_USER=tu-email@gmail.com
SMTP_PASS=tu-contraseña-de-aplicacion

# WhatsApp (opcional - Meta Business)
WHATSAPP_TOKEN=tu-token-de-whatsapp
WHATSAPP_PHONE_ID=tu-phone-id
