generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int          @id @default(autoincrement())
  email       String       @unique
  password    String
  role        Role         @default(ADMIN)
  name        String?
  phone       String?
  createdAt   DateTime     @default(now())
  
  resetToken       String?
  resetTokenExpiry DateTime?
  
  // Permisos para WORKERS (ADMIN tiene todos por defecto)
  canViewClients       Boolean @default(true)
  canEditClients       Boolean @default(false)
  canDeleteClients     Boolean @default(false)
  
  canViewPersonal      Boolean @default(false)
  canEditPersonal      Boolean @default(false)
  canDeletePersonal    Boolean @default(false)
  
  canViewServices      Boolean @default(true)
  canEditServices      Boolean @default(false)
  canDeleteServices    Boolean @default(false)
  
  canViewInventory     Boolean @default(false)
  canEditInventory     Boolean @default(false)
  canDeleteInventory   Boolean @default(false)
  
  canViewReports       Boolean @default(false)
  canViewMarketing     Boolean @default(false)
  
  canConfirmAppointments  Boolean @default(false)
  canCancelAppointments   Boolean @default(false)
  // Nota: Completar/Marcar no asistencia siempre permitido para workers
  
  salon       Salon?       @relation("SalonAdmin")
  worksAt     Salon?       @relation("SalonWorkers", fields: [salonId], references: [id])
  salonId     Int?

  stylistAppointments Appointment[] @relation("stylistAppointments")
  notifications       Notification[]
}

enum Role {
  WORKER
  ADMIN
}

model Salon {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  address     String?
  city        String?
  phone       String?
  description String?

  adminId     Int     @unique
  admin       User    @relation("SalonAdmin", fields: [adminId], references: [id])
  workers     User[]  @relation("SalonWorkers")

  services    Service[]
  clients     Client[]
  employees   Employee[]
  config      Config?
  inventory   Inventory[]
  schedules   SalonSchedule[]
  scheduleBlocks ScheduleBlock[]
}

model Config {
  id                       Int      @id @default(autoincrement())
  salonId                  Int      @unique
  requireConfirmation      Boolean  @default(false)
  workersCanCreateServices Boolean  @default(false)
  canAcceptAppointments    Boolean  @default(true)
  canModifyAppointments    Boolean  @default(true)

  openingTime              String   @default("09:00")
  closingTime              String   @default("18:00")
  serviceIntervalMinutes   Int      @default(30)
  
  // Personalización del slug público
  publicPageBackground     String?  @default("bg-gradient-to-br from-purple-50 via-pink-50 to-purple-100")
  publicPagePrimaryColor   String?  @default("#9333ea")
  publicPageSecondaryColor String?  @default("#ec4899")

  salon   Salon @relation(fields: [salonId], references: [id])
}

model SalonSchedule {
  id          Int      @id @default(autoincrement())
  salonId     Int
  dayOfWeek   Int      // 0=Domingo, 1=Lunes, 2=Martes, ... 6=Sábado
  openingTime String   // Formato "HH:MM"
  closingTime String   // Formato "HH:MM"
  isClosed    Boolean  @default(false)

  salon       Salon    @relation(fields: [salonId], references: [id])
}

model ScheduleBlock {
  id          Int      @id @default(autoincrement())
  salonId     Int
  date        DateTime // Fecha específica del bloqueo
  startTime   String   // Formato "HH:MM"
  endTime     String   // Formato "HH:MM"
  reason      String?  // Motivo del bloqueo (vacaciones, evento, etc.)
  createdAt   DateTime @default(now())

  salon       Salon    @relation(fields: [salonId], references: [id])
}

model Service {
  id          Int          @id @default(autoincrement())
  name        String
  description String?
  duration    Int
  price       Float

  salonId     Int
  salon       Salon        @relation(fields: [salonId], references: [id])

  appointments Appointment[]
}

model Client {
  id        Int    @id @default(autoincrement())
  name      String
  phone     String?
  email     String?

  salonId   Int
  salon     Salon @relation(fields: [salonId], references: [id])

  appointments Appointment[]
}

model Employee {
  id        Int    @id @default(autoincrement())
  name      String
  role      String?

  salonId   Int
  salon     Salon @relation(fields: [salonId], references: [id])
}

model Appointment {
  id        Int    @id @default(autoincrement())
  clientId  Int
  stylistId Int
  serviceId Int
  startTime DateTime
  endTime   DateTime
  status    AppointmentStatus @default(PENDING)
  createdAt DateTime @default(now())

  client    Client @relation(fields: [clientId], references: [id])
  stylist   User   @relation("stylistAppointments", fields: [stylistId], references: [id])
  service   Service @relation(fields: [serviceId], references: [id])
  payment   Payment?
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Inventory {
  id                Int    @id @default(autoincrement())
  productName       String
  quantity          Int
  lowStockThreshold Int?

  salonId Int
  salon   Salon @relation(fields: [salonId], references: [id])
}

model Payment {
  id            Int     @id @default(autoincrement())
  appointmentId Int     @unique
  amount        Float
  paymentMethod PaymentMethod
  status        PaymentStatus
  createdAt     DateTime @default(now())

  appointment   Appointment @relation(fields: [appointmentId], references: [id])
}

enum PaymentMethod {
  CARD
  CASH
  BIZUM
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

model Notification {
  id        Int    @id @default(autoincrement())
  userId    Int
  message   String
  type      NotificationType
  read      Boolean @default(false)
  sentAt    DateTime @default(now())

  user      User @relation(fields: [userId], references: [id])
}

enum NotificationType {
  REMINDER
  CANCELLATION
  PROMOTION
}
